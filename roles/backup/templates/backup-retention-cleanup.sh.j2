#!/bin/bash

set -Eeuo pipefail
umask 027

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

BACKUP_ROOT="{{ backup_server_root }}"
DATA_DIR="{{ backup_server_data_dir }}"
LOG_DIR="{{ backup_server_log_dir }}"
LOG_FILE="${LOG_DIR}/backup-retention.log"

DEFAULT_DRY_RUN="{{ backup_cleanup_dry_run | bool | ternary('1', '0') }}"
DRY_RUN="${DEFAULT_DRY_RUN}"

usage()
{
    echo "Usage: $0 [--dry-run|--apply]"
}

case "${1:-}" in
    "")
        ;;
    --dry-run)
        DRY_RUN=1
        ;;
    --apply)
        DRY_RUN=0
        ;;
    *)
        usage
        exit 64
        ;;
esac

mkdir -p "${LOG_DIR}"
touch "${LOG_FILE}"
chmod 0640 "${LOG_FILE}"
chown root:backupsvc "${LOG_FILE}"

exec >>"${LOG_FILE}" 2>&1

echo
echo "============================================================"
echo "Central Backup Retention Cleanup"
echo "Start time : $(date '+%F %T')"
echo "Mode       : $([ "${DRY_RUN}" -eq 1 ] && echo DRY-RUN || echo APPLY)"
echo "Data dir   : ${DATA_DIR}"
echo "============================================================"

if [ ! -d "${DATA_DIR}" ]; then
    echo "ERROR: backup data directory does not exist"
    exit 1
fi

BACKUP_ROOT_REAL="$(readlink -f "${BACKUP_ROOT}")"
DATA_DIR_REAL="$(readlink -f "${DATA_DIR}")"

if [ "${BACKUP_ROOT_REAL}" != "/backup" ]; then
    echo "ERROR: unexpected backup root: ${BACKUP_ROOT_REAL}"
    exit 1
fi

if [ "${DATA_DIR_REAL}" != "/backup/data" ]; then
    echo "ERROR: unexpected backup data directory: ${DATA_DIR_REAL}"
    exit 1
fi

CURRENT_EPOCH="$(date +%s)"
DELETED_COUNT=0
RECLAIMED_BYTES=0

cleanup_node()
{
    local node_name="$1"
    local retention_days="$2"
    local node_dir="${DATA_DIR_REAL}/${node_name}"
    local node_dir_real
    local cutoff_epoch
    local directory_name
    local directory_path
    local directory_real
    local directory_epoch
    local directory_bytes

    if [ ! -d "${node_dir}" ]; then
        echo "WARNING: node directory does not exist: ${node_dir}"
        return 0
    fi

    node_dir_real="$(readlink -f "${node_dir}")"

    case "${node_dir_real}" in
        "${DATA_DIR_REAL}/"*)
            ;;
        *)
            echo "ERROR: unsafe node directory: ${node_dir_real}"
            return 1
            ;;
    esac

    cutoff_epoch="$((CURRENT_EPOCH - retention_days * 86400))"

    echo
    echo "Node       : ${node_name}"
    echo "Retention  : ${retention_days} days"

    while IFS= read -r directory_name
    do
        if [[ ! "${directory_name}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            echo "SKIP: non-date directory: ${node_dir}/${directory_name}"
            continue
        fi

        directory_path="${node_dir}/${directory_name}"
        directory_real="$(readlink -f "${directory_path}")"

        case "${directory_real}" in
            "${node_dir_real}/"*)
                ;;
            *)
                echo "ERROR: unsafe backup directory: ${directory_real}"
                continue
                ;;
        esac

        directory_epoch="$(date -d "${directory_name} 00:00:00" +%s 2>/dev/null || true)"

        if [ -z "${directory_epoch}" ]; then
            echo "SKIP: invalid date directory: ${directory_real}"
            continue
        fi

        if [ "${directory_epoch}" -ge "${cutoff_epoch}" ]; then
            echo "KEEP: ${directory_real}"
            continue
        fi

        directory_bytes="$(du -sb "${directory_real}" 2>/dev/null | awk '{print $1}')"
        directory_bytes="${directory_bytes:-0}"

        if [ "${DRY_RUN}" -eq 1 ]; then
            echo "WOULD DELETE: ${directory_real} bytes=${directory_bytes}"
        else
            echo "DELETE: ${directory_real} bytes=${directory_bytes}"
            rm -rf -- "${directory_real}"
            DELETED_COUNT=$((DELETED_COUNT + 1))
            RECLAIMED_BYTES=$((RECLAIMED_BYTES + directory_bytes))
        fi
    done < <(
        find "${node_dir_real}" \
          -mindepth 1 \
          -maxdepth 1 \
          -type d \
          -printf '%f\n' |
        sort
    )
}

{% for node_name, retention_days in backup_retention_policies | dictsort %}
cleanup_node "{{ node_name }}" "{{ retention_days }}"
{% endfor %}

echo
echo "Deleted directories : ${DELETED_COUNT}"
echo "Reclaimed bytes     : ${RECLAIMED_BYTES}"
echo "Finish time         : $(date '+%F %T')"
echo "============================================================"
