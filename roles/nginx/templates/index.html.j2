<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>{{ web_application_name }}</title>
</head>
<body>

<h1>{{ web_application_name }}</h1>

<p>Environment: {{ web_environment | default('production') }}</p>

